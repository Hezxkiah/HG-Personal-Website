---
import { Picture } from "astro:assets";
import ProjArr from '@assets/landing/arrow-down.svg'
---
<section id="Landing">
    <div id="landing-text">
        <div id="status">
            <span id="dot"></span>
            <span>Available for new opporunites</span>
        </div>
        <h1>Software Engineer</h1>
        <p>Sophomore CS & Math major at Texas A&M. 
            <br> Organizer for <u><a href="https://tamuhack.org/" id="mention" target="_blank">@TAMUhack</a></u> and I ship 
            projects on the side.
        </p>
        <div id="projects-scroll" onclick="document.getElementById('Projects').scrollIntoView({ behavior: 'smooth' })">
            <p>Projects</p>
            <img src={ProjArr.src} alt="" width="20" height="20" />
        </div>
    </div>
</section>

<style>
    /* Landing Text */
    #Landing{
        display: flex;
        justify-content: left;
        align-items: flex-start;
        min-height: 100vh;
        width: 100%;
        margin-top: 10rem;
        margin-left: 10rem;
    }
    @media (max-width: 768px) {
        #Landing {
            margin-top: 4rem;
            margin-left: 3.5rem;
            margin-right: 1.5rem;
            min-height: 100vh;
            width: auto;
        }
    }
    #landing-text h1 {
        font-size: clamp(1rem, 8vw, 4rem);
        text-align: left;
    }
    #landing-text p {
        color: #ABAEB0;
        font-size: clamp(0.5rem, 8vw, 1.5rem);
        text-align: left;
    }
    #status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: monospace;
        color: #ABAEB0;
        font-size: 0.9rem;
    }
    #dot {
        width: 10px;
        height: 10px;
        background-color: #4ade80;
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6);
        }
        50% {
            box-shadow: 0 0 0 6px rgba(74, 222, 128, 0);
        }
    }
    #mention {
        color: #6D6F70;
        transition: color 0.2s ease;
    }
    #mention:hover {
        color: white;
    }
    #projects-scroll {
        padding-top: 1.5rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        gap: 0.25rem;
    }

    #projects-scroll img {
        filter: brightness(0) invert(0.67);
        transition: filter 0.2s ease;
        width: 20px;
        height: 20px;
    }

    #projects-scroll p {
        color: #ABAEB0;
        font-size: 1rem;
        margin: 0;
        transition: color 0.2s ease;
    }

    #projects-scroll:hover img {
        filter: brightness(0) invert(1);
    }

    #projects-scroll:hover p {
        color: white;
    }
</style>