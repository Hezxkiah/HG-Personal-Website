---
import { Picture } from "astro:assets";
import GitHub from "@assets/menu/github-icon.svg";
import LinkedIn from "@assets/menu/linkedin-icon.svg";
import Resume from "@assets/menu/document-icon.svg";
---
<section id="Menu">
    <div id="menu-bar-text">
        <p>Hezekiah<br>Gitenyi</p>
    </div>
    <div id="menu-bar-socials">
        <a href="https://github.com/Hezxkiah" target="_blank" id="Github">
            <img src={GitHub.src} alt="GitHub" width="35" height="35" />
        </a>
        <a href="https://www.linkedin.com/in/hezekiah-gitenyi/" target="_blank" id="Linkedin">
            <img src={LinkedIn.src} alt="LinkedIn" width="35" height="35" />            
        </a>
        <a href="/resume.pdf" target="_blank" id="Resume">
            <img src={Resume.src} alt="Resume" width="35" height="35" />            
        </a>
    </div>
</section>

<style>
    #Menu {
        display: flex;
        margin-top: 5vh;
        width: 100%;
    }
    #menu-bar-text {
        flex: auto;
        font-size: clamp(1rem, 2vw, 2rem);
        margin-left: 10rem;
    }

    #menu-bar-text p {
        text-align: left;
        margin: 0;
    }
    #menu-bar-socials {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding-right: 10rem;
    }
    #Github,
    #Linkedin,
    #Resume {
        display: flex;
        align-items: center;
        filter: brightness(0) invert(1);
        transition: opacity 0.2s ease;
        display: block;
    }
    #Github:hover,
    #Linkedin:hover,
    #Resume:hover {
        opacity: 0.5;
    }
    @media (max-width: 768px) {
        #Menu {
            align-items: center;
            padding: 0 1.5rem;
        }
        #menu-bar-text {
            margin-left: 2.1rem
        }
        #menu-bar-socials {
            padding-right: 2rem;
            gap: 1rem;
        }
    }
</style>
