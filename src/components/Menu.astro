<style>
    #Menu {
        display: flex;
        margin-top: 5vh;
        width: 100%;
    }
    #menu-bar-text {
        flex: auto;
        font-size: clamp(1rem, 2vw, 2rem);
        margin-left: 10rem;
    }

    #menu-bar-text p {
        text-align: left;
        margin: 0;
    }
    #menu-bar-socials {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding-right: 10rem;
    }
    #Github,
    #Linkedin,
    #Resume {
        display: flex;
        align-items: center;
        filter: brightness(0) invert(1);
        transition: opacity 0.2s ease;
        display: block;
    }
    #Github:hover,
    #Linkedin:hover,
    #Resume:hover {
        opacity: 0.5;
    }
    @media (max-width: 768px) {
        #Menu {
            align-items: center;
            padding: 0 1.5rem;
        }
        #menu-bar-text {
            margin-left: 2.1rem
        }
        #menu-bar-socials {
            padding-right: 2rem;
            gap: 1rem;
        }
    }
</style>
