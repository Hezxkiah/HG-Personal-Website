---
import F1Project from '@components/projects/f1-project.astro'
---
<section id="Projects">
    <div class="project-box">
        <F1Project/>
    </div>
</section>
    
<style>
    #Projects {
        min-height: 100vh;
        min-width: 100%;
        display: flex;
        align-items: center;
        justify-content: start;
        padding: 4rem 10rem;
        box-sizing: border-box;
    }

    .project-box {
        border: 2px solid #2e2e2e;
        border-radius: 16px;
        padding: 2rem;
    }
</style>