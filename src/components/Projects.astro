---
import F1Project from "@components/projects/f1-project.astro";
import TamuGuessr from "./projects/tamu-guessr.astro";
import HowdyHack26 from "./projects/howyhack26.astro";
---
<section id="Projects">
    <div class="project-box">
        <HowdyHack26/>
    </div>
    <div class="project-box">
        <F1Project/>
    </div>
    <div class="project-box">
        <TamuGuessr/>
    </div>
</section>
    
<style>
    #Projects {
        min-height: 10%;
        min-width: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        padding: 4% 10%;
        box-sizing: border-box;
        gap: 2rem;
    }
    .project-box {
        border: 2px solid #2e2e2e;
        border-radius: 16px;
        padding: clamp(1rem, 3%, 2rem);
        width: 100%;
        box-sizing: border-box;
    }
    @media (max-width: 768px) {
        #Projects {
            padding: 2rem 2.5rem;
        }
    }
</style>