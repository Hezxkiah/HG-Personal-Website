---
import { Picture } from "astro:assets";
import RepoArr from "@assets/projects/arrow-up-right.png";
import F1Car from "@assets/projects/formula-1.avif";

const techs = ["PyTorch", "Pandas", "NumPy", "Matplotlib", "Linear Regression"];
---
<div id="project-card">
    <div class="img-wrap">
        <Picture
            src={F1Car}
            alt={''}
            formats={["avif","webp"]}
            densities={[1,2]}
            quality={80}
            aria-hidden="true"
            loading={"eager"}
            fetchpriority={"high"}
        />
    </div>
    
    <div id="project-description">
        <h1>Formula-1 Tire Model</h1>
        <p>By utilizing per-stint linear regression on lap data collected via FastF1, 
            I analyzed tire compound efficiency across the entire 2024 Formula 1 season. 
            Degradation rates and base pace were computed per driver per stint, 
            then combined into a single efficiency score using an integral of the linear degradation model over the average stint length.
            Across 23 dry-weather races, HARD tires were the most efficient compound at 12 circuits, 
            particularly high-speed tracks like Silverstone, Monza, and Zandvoort, 
            while SOFT tires dominated street circuits where shorter stints favor raw pace over durability,
            and MEDIUM tires were optimal at 3 circuits where neither extreme dominated.
        </p>
        <div id="tech-stack">
            {techs.map(tech => (
                <span class="bubble">{tech}</span>
            ))}
        </div>
        <div id="repo-link">
            <a href="https://github.com/Hezxkiah/F1-Tire-Model" target="_blank">
            <p>Github</p>
            <img src={RepoArr.src} alt="" />
            </a>
        </div>
    </div>
</div>

<style>
    #project-card {
        display: flex;
        align-items: center;
        gap: 5%;
    }
    #project-card h1{
        font-size: clamp(1.4rem, 2.5vw, 2rem);
    }
    .img-wrap {
        width: 45%;
        height: 360px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 10px;
    }
    .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    #tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .bubble {
        border: 1px solid #3e3e3e;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        color: #ABAEB0;
        font-family: monospace;
    }
    #repo-link{
        padding-top: 1.5rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        gap: 0.25rem;
    }
    #repo-link a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
    }
    #repo-link img{
        filter: brightness(0) invert(0.67);
        transition: filter 0.2s ease;
        width: 20px;
        height: 20px;
    }
    #repo-link p{
        color: #ABAEB0;
        font-size: 1rem;
        margin: 0;
        transition: color 0.2s ease;
    }
    #repo-link:hover img {
        filter: brightness(0) invert(1);
    }
    #repo-link:hover p {
        color: white;
    }
    @media (max-width: 768px) {
        #project-card {
            flex-direction: column;
            gap: 1.5rem;
            margin-right: 1rem;
        }

        .img-wrap {
            width: 100%;
            height: 220px;
            max-width: 100%;
        }

        #project-card h1 {
            font-size: 1.5rem;
        }
    }
</style>
