---
import { Picture } from "astro:assets";
import RepoArr from "@assets/projects/arrow-up-right.png";
import F1Car from "@assets/projects/formula-1-ferrari.jpg";
import RaceCarIcon from "@assets/projects/race-car.svg"

const techs = ["PyTorch", "Pandas", "NumPy", "Matplotlib", "XGBoost"];
---
<div id="project-card">
    <div class="img-wrap">
        <Picture
            src={F1Car}
            alt={''}
            formats={["avif","webp"]}
            aria-hidden="true"
            loading={"eager"}
            fetchpriority={"high"}
        />
    </div>
    
    <div id="project-description">
        <h1 id="proj-title">Formula-1 Tire Model</h1>
        <p>
            To understand how tire and pit strategy affect race outcomes, 
            I built a linear regression model based on the base pace and degradation rate for every driver, 
            then integrated along the average stint length to return an efficiency score. 
            The results showed HARD tires averaged 3.55% higher efficiency than SOFT and 2.03% higher than MEDIUM. 
            Alongside this, I developed an XGBoost regression model trained on tire age, compound, 
            and track conditions to simulate full-race pit strategies, 
            which was validated with race-grouped cross-validation against a 10-race holdout set. 
            The model came within 1.2% (89.8s MAE) of actual outcomes.
        </p>
        <div id="tech-stack">
            {techs.map(tech => (
                <span class="bubble">{tech}</span>
            ))}
        </div>
        <div id="repo-link">
            <a href="https://github.com/Hezxkiah/F1-Tire-Model" target="_blank">
            <p>Github</p>
            <img src={RepoArr.src} alt="" />
            </a>
        </div>
    </div>
</div>

<style>
    #project-card {
        display: flex;
        align-items: center;
        gap: 5%;
    }
    #project-card h1{
        font-size: clamp(1.4rem, 2.5vw, 2rem);
    }
    .img-wrap {
        width: 45%;
        height: 360px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 10px;
    }
    .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    #tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .bubble {
        border: 1px solid #3e3e3e;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        color: #ABAEB0;
        font-family: monospace;
    }
    #repo-link{
        padding-top: 1.5rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        gap: 0.25rem;
    }
    #repo-link a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
    }
    #repo-link img{
        filter: brightness(0) invert(0.67);
        transition: filter 0.2s ease;
        width: 20px;
        height: 20px;
    }
    #repo-link p{
        color: #ABAEB0;
        font-size: 1rem;
        margin: 0;
        transition: color 0.2s ease;
    }
    #repo-link:hover img {
        filter: brightness(0) invert(1);
    }
    #repo-link:hover p {
        color: white;
    }
    @media (max-width: 768px) {
        #project-card {
            flex-direction: column;
            gap: 1.5rem;
            margin-right: 1rem;
        }

        .img-wrap {
            width: 100%;
            height: 220px;
            max-width: 100%;
        }

        #project-card h1 {
            font-size: 1.5rem;
        }
    }
</style>

