---
import { Picture } from "astro:assets";
import RepoArr from "@assets/projects/arrow-up-right.png";
import HowdyHack26 from "@assets/projects/howdyhack26.png";
const techs = ["Astro", "Next.js", "GSAP", "TailwindCSS", "Figma"];
---
<div id="project-card">
    <div class="img-wrap">
        <Picture
            src={HowdyHack26}
            alt={''}
            formats={["avif","webp"]}
            aria-hidden="true"
            loading={"eager"}
            fetchpriority={"high"}
        />
    </div>
    
    <div id="project-description">
        <h1 id="proj-title">HowdyHack 2026</h1>
        <p>
             Built frontend components for HowdyHack 2026 drawing 10,000+ site visitors. Working within the dev team, I owned the About section end-to-end and engineered the animated 
             bubble text interactions using GSAP. Leveraged Astro's native Image component to optimize asset delivery across the landing page, improving load performance for 
             high-traffic visitor spikes.
        </p>
        <div id="tech-stack">
            {techs.map(tech => (
                <span class="bubble">{tech}</span>
            ))}
        </div>
        <div id="repo-link">
            <a href="https://hh26.tamuhack.org/#about" target="_blank">
            <p>Website</p>
            <img src={RepoArr.src} alt="" />
            </a>
        </div>
    </div>
</div>

<style>
    #project-card {
        display: flex;
        align-items: center;
        gap: 5%;
    }
    #project-card h1{
        font-size: clamp(1.4rem, 2.5vw, 2rem);
    }
    .img-wrap {
        width: 45%;
        height: 360px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 10px;
    }
    .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    #tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .bubble {
        border: 1px solid #3e3e3e;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        color: #ABAEB0;
        font-family: monospace;
    }
    #repo-link{
        padding-top: 1.5rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        gap: 0.25rem;
    }
    #repo-link a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
    }
    #repo-link img{
        filter: brightness(0) invert(0.67);
        transition: filter 0.2s ease;
        width: 20px;
        height: 20px;
    }
    #repo-link p{
        color: #ABAEB0;
        font-size: 1rem;
        margin: 0;
        transition: color 0.2s ease;
    }
    #repo-link:hover img {
        filter: brightness(0) invert(1);
    }
    #repo-link:hover p {
        color: white;
    }
    @media (max-width: 768px) {
        #project-card {
            flex-direction: column;
            gap: 1.5rem;
            margin-right: 1rem;
        }

        .img-wrap {
            width: 100%;
            height: 220px;
            max-width: 100%;
        }

        #project-card h1 {
            font-size: 1.5rem;
        }
    }
</style>