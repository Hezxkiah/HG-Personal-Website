---
import { Picture } from "astro:assets";
import TAMUGuessr from '@assets/projects/tamu-guessr.png'
import RepoArr from '@assets/projects/arrow-up-right.png'
const techs = ['Next.js', 'Tailwind CSS', 'Google Maps API', 'React', 'Javascript'];
---
<div id="project-card">
    <div class="img-wrap">
        <Picture
            src={TAMUGuessr}
            alt={''}
            formats={["png","avif","webp"]}
            densities={[1,2]}
            quality={80}
            aria-hidden="true"
            loading={"eager"}
            fetchpriority={"high"}
        />
    </div>
    
    <div id="project-description">
        <h1>TAMUGuessr</h1>
        <h2>2nd Place <a href="https://hh25.tamuhack.org/" id="mention"><u>@HowdyHack</u></a> 2025</h2>
        <p>We identified that many new and current students are unfamiliar with how large their own campus is. 
            Texas A&M spans over 5,000 acres, and as a result, 
            most students have not been fully exposed to the campus they call home. 
            To tackle this issue, we drew inspiration from GeoGuessr, 
            a game that places you in a random location worldwide and challenges you to guess where you are. 
            This model successfully exposes people to new places and motivates them to explore in person. 
            We wanted to bring this concept to Texas A&M, creating a game with weekly themes. 
            This approach not only helps students find new places on campus to hang out but also guides them to locations 
            where they can connect with others who share their interests.
        </p>
        <div id="tech-stack">
            {techs.map(tech => (
                <span class="bubble">{tech}</span>
            ))}
        </div>
        <div id="links">
            <div id="repo-link">
                <a href="https://github.com/Hezxkiah/TAMU-Guessr" target="_blank">
                <p>Github</p>
                <img src={RepoArr.src} alt="" />
                </a>
            </div>
            <div id="repo-link">
                <a href="https://devpost.com/software/tamu-guessr?ref_content=my-projects-tab&ref_feature=my_projects" target="_blank">
                <p>Devpost</p>
                <img src={RepoArr.src} alt="" />
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    #project-card {
        display: flex;
        align-items: center;
        gap: 5rem;
    }
    #project-card h1{
        font-size: 2rem;
    }
    #project-description h2{
        color: #FFDE00;
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
    }
    #mention {
        color: #FFDE00;
        transition: color 0.2s ease;
    }
    #mention:hover {
        color: white;
    }
    .img-wrap {
        width: 500px;
        height: 360px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 10px;
    }
    .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    #tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .bubble {
        border: 1px solid #3e3e3e;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        color: #ABAEB0;
        font-family: monospace;
    }
    #links{
        display: flex;
        gap: 0.5rem;
    }
    #repo-link{
        padding-top: 1.5rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        gap: 0.25rem;
    }
    #repo-link a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
    }
    #repo-link img{
        filter: brightness(0) invert(0.67);
        transition: filter 0.2s ease;
        width: 20px;
        height: 20px;
    }
    #repo-link p{
        color: #ABAEB0;
        font-size: 1rem;
        margin: 0;
        transition: color 0.2s ease;
    }
    #repo-link:hover img {
        filter: brightness(0) invert(1);
    }
    #repo-link:hover p {
        color: white;
    }
    @media (max-width: 768px) {
        #project-card {
            flex-direction: column;
            gap: 1.5rem;
            margin-right: 1rem;
        }

        .img-wrap {
            width: 100%;
            height: 220px;
            max-width: 100%;
        }

        #project-card h1 {
            font-size: 1.5rem;
        }
    }
</style>
